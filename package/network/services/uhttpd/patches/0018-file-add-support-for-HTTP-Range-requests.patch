+static void uh_file_response_206(struct client *cl, struct stat *s,
+				 struct uh_file_range *range)
+{
+	uh_http_header(cl, 206, "Partial Content");
+	ustream_printf(cl->us, "Content-Range: bytes %" PRIu64 "-%" PRIu64 "/%" PRIu64 "\r\n",
+		       range->start, range->start + range->length - 1,
+		       (uint64_t)s->st_size);
+	return uh_file_response_ok_hdrs(cl, s);
+}
+
+static void uh_file_response_416(struct client *cl, struct stat *s)
+{
+	uh_http_header(cl, 416, "Range Not Satisfiable");
+	ustream_printf(cl->us, "Accept-Ranges: bytes\r\n");
+	ustream_printf(cl->us, "Content-Range: bytes */%" PRIu64 "\r\n",
+		       (uint64_t)s->st_size);
+	ustream_printf(cl->us, "Content-Type: text/html\r\n");
+	ustream_printf(cl->us, "Content-Length: 0\r\n\r\n");
+}
