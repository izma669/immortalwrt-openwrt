+static void uh_range_skip_ws(const char **str)
+{
+	while (**str == ' ' || **str == '\t')
+		(*str)++;
+}
+
+static bool uh_range_parse_u64(const char **str, uint64_t *val)
+{
+	const char *p = *str;
+	uint64_t v = 0;
+	bool found = false;
+
+	while (*p >= '0' && *p <= '9') {
+		unsigned int digit = *p - '0';
+
+		if (v > (UINT64_MAX - digit) / 10)
+			return false;
+
+		v = v * 10 + digit;
+		found = true;
+		p++;
+	}
+
+	if (!found)
+		return false;
+
+	*val = v;
+	*str = p;
+
+	return true;
+}
+
+static enum uh_range_result
+uh_file_parse_range(const char *str, uint64_t size, struct uh_file_range *range)
+{
+	uint64_t first, last;
+	const char *p;
+
+	if (!str)
+		return UH_RANGE_NONE;
+
+	uh_range_skip_ws(&str);
+
+	if (strncasecmp(str, "bytes", 5))
+		return UH_RANGE_NONE;
+
+	p = str + 5;
+	uh_range_skip_ws(&p);
+
+	if (*p != '=')
+		return UH_RANGE_NONE;
+
+	p++;
+	uh_range_skip_ws(&p);
+
+	/* only single ranges are supported, serve the full entity instead */
+	if (strchr(p, ','))
+		return UH_RANGE_NONE;
+
+	/* an empty entity cannot be satisfied by any range */
+	if (!size)
+		return UH_RANGE_UNSATISFIABLE;
+
+	/* suffix range, e.g. "bytes=-500" */
+	if (*p == '-') {
+		p++;
+		uh_range_skip_ws(&p);
+
+		if (!uh_range_parse_u64(&p, &last))
+			return UH_RANGE_NONE;
+
+		uh_range_skip_ws(&p);
+
+		if (*p)
+			return UH_RANGE_NONE;
+
+		if (!last)
+			return UH_RANGE_UNSATISFIABLE;
+
+		if (last > size)
+			last = size;
+
+		range->start = size - last;
+		range->length = last;
+
+		return UH_RANGE_OK;
+	}
+
+	if (!uh_range_parse_u64(&p, &first))
+		return UH_RANGE_NONE;
+
+	uh_range_skip_ws(&p);
+
+	if (*p != '-')
+		return UH_RANGE_NONE;
+
+	p++;
+	uh_range_skip_ws(&p);
+
+	/* open ended range, e.g. "bytes=500-" */
+	if (!*p) {
+		last = size - 1;
+	} else {
+		if (!uh_range_parse_u64(&p, &last))
+			return UH_RANGE_NONE;
+
+		uh_range_skip_ws(&p);
+
+		if (*p)
+			return UH_RANGE_NONE;
+	}
+
+	if (first >= size || first > last)
+		return UH_RANGE_UNSATISFIABLE;
+
+	if (last >= size)
+		last = size - 1;
+
+	range->start = first;
+	range->length = last - first + 1;
+
+	return UH_RANGE_OK;
+}
